<?xml version="1.0" encoding="utf-8"?>
<!--
    THERE IS NO KOTLIN. THERE IS NO JAVA. THIS FILE IS WHAT MAKES THAT TRUE.

    `android:hasCode="false"` tells the framework there is no dex in this APK. It loads
    `android.app.NativeActivity`  —  a class that already ships on every device  —  which in turn
    dlopens `liboutbreak.so` and calls `ANativeActivity_onCreate`. That symbol is in `android.zig`.

    So the entire application is one shared library of Zig. No JVM class of ours is ever written,
    no Java is ever compiled, and there is no bridge to maintain between two languages.

    `android.app.lib_name` is the ONLY link between this file and the code: it names the library,
    without the `lib` prefix and without the `.so`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.outbreak.game"
    android:versionCode="1"
    android:versionName="0.1-phase3">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!--
        LOCATION. The permission this whole game is about, and the one it asks for last.

        FINE, not COARSE: a coarse fix is a few hundred metres, which is several rooms wide, and a
        room is the unit the entire design rests on.

        What the player grants is not what the game keeps. The coordinate lives for the length of
        one expression in one function (src/location.zig), becomes a u64 room id, and dies. There
        is no coordinate on the wire, none in the journal, and none on the server — the build
        fails if a float appears in a file classified core.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The foreground service that keeps the radio alive while backgrounded (M.6). The typed
         permission is required on Android 14+; it declares WHY the service runs in the background,
         and "location" is the honest answer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- The socket (M.7). The client sends a session token and a u64 room id, and reads back a
         fixed-size tell. It never sends a coordinate — the coordinate died in location.zig. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The combat alert (M.8). On Android 13+ posting a notification requires this runtime
         permission; without it the "your cell is live" alert is silently dropped (the ongoing
         foreground-service notification is exempt, which is why the bug hides until you look).
         The notification carries a categorical crowd band only — never a count, a who, or a where. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The GPS hardware is required. A phone without it cannot know which room it is in. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="true" />

    <!--
        NOT YET REQUESTED, AND DELIBERATELY SO.

INTERNET carries the room to the server and the tell back. The coordinate is never on it.
    -->

    <!--
        `extractNativeLibs="true"` on purpose. From targetSdk 30 the default is false, which
        requires the .so to be stored UNCOMPRESSED and page-aligned inside the APK. That is a
        smaller install and a faster start, and it is worth doing before this ships  —  but it is
        a packaging constraint, and a packaging constraint that fails produces an install error
        with no obvious cause. Explicit beats defaulted while the thing is being brought up.
    -->
    <!--
        `hasCode` IS TRUE NOW, AND IT COST US SOMETHING TO SAY SO.

        This file used to declare there was no code in the APK at all: the framework loaded a
        shared library and not one class of ours was ever written. That was true, and it was a
        good thing to be able to say.

        Android has no native location API. There is no LocationManager in the NDK, there never
        has been, and every route to a live fix runs through a Java callback object — which needs
        a class, which needs a dex. JNI cannot conjure one.

        So there is exactly ONE class: android/java/com/outbreak/game/Fix.java. It has NO FIELDS.
        It receives a Location, reads two doubles out of it, hands them to Zig, and forgets. If
        that file ever grows, something has gone wrong.
    -->
    <application
        android:label="Outbreak"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|density">

            <meta-data
                android:name="android.app.lib_name"
                android:value="outbreak" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The foreground service. `foregroundServiceType="location"` is what lets a backgrounded
             app keep receiving fixes; without it Android throttles background location to a few per
             hour and eventually kills the process. It is not exported: nothing outside the app may
             start it. -->
        <service
            android:name=".OutbreakService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
