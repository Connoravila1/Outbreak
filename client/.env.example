# Server base URL; empty = same origin (dev proxy / reverse proxy).
VITE_SERVER_URL=
# Set to 1 to always use the in-browser mock server (also: ?mock=1).
VITE_MOCK=
# Sign-in (docs/ACCOUNTS_SETUP.md). A browser build also learns the web IDs from the server's /api/health,
# so these matter mostly for the Android/iOS builds. Leave empty to hide a provider on that build.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_APPLE_SERVICE_ID=
VITE_APPLE_REDIRECT_URL=
