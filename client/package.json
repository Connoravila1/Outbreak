{
  "name": "outbreak-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && cap sync android && cd android && ./gradlew bundleRelease",
    "ios:sync": "npm run build && cap sync ios",
    "icons:ios": "node scripts/ios-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "maplibre-gl": "^6.16.0",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@preact/preset-vite": "^2.10.6",
    "@types/geojson": "^7946.0.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
